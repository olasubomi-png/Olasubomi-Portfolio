# ============================================================
# OLASUBOMI Portfolio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins (* = all)
ALLOWED_ORIGINS=*

# Contact form email recipient
ADMIN_EMAIL=vegasola8@gmail.com

# SMTP (for nodemailer — leave blank to only log contact submissions)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# MongoDB (future integration)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio
