# ============================================================
# OLASUBOMI Portfolio Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public URL of the app (used in email links, redirects)
# In production set to your actual domain e.g. https://yourdomain.com
CLIENT_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins (* = all)
ALLOWED_ORIGINS=*

# ── JWT (Auth) ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string-for-production
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string-for-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Cookie ────────────────────────────────────────────────────
# In production, set to your root domain e.g. .yourdomain.com
COOKIE_DOMAIN=

# ── MongoDB ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio-platform

# ── Email (SMTP) ──────────────────────────────────────────────
# Leave blank to fall back to console logging (dev only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
ADMIN_EMAIL=vegasola8@gmail.com
EMAIL_FROM="Portfolio Platform" <your-email@gmail.com>

# ── Session (legacy — kept for compatibility) ─────────────────
SESSION_SECRET=change-me-session-secret
